# Base URL of the deployed API Gateway stage (no trailing slash).
# Leave empty to run fully offline: incidents queue in IndexedDB and never sync.
VITE_API_BASE_URL=

# Number dialled by the "Call now" buttons.
# 112 (India/EU, default), 911 (US), 999 (UK), 000 (AU).
VITE_EMERGENCY_NUMBER=112
VITE_EMERGENCY_LABEL=India
